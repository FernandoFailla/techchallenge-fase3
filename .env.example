# Kaggle API token used to download the approved public dataset.
KAGGLE_API_TOKEN=

# OAuth client for the local DVC Google Drive remote.
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=

# MLflow Tracking URI for commands executed on the host. Compose services use
# their own addresses instead.
MLFLOW_TRACKING_URI=http://localhost:5000

# Optional host-reachable URI used only by the Airflow container. Do not set it
# unless MLflow is intentionally exposed somewhere other than the local host.
# AIRFLOW_MLFLOW_TRACKING_URI=http://host.docker.internal:5000

# Optional MLflow Registry URI for the API. The Compose API service connects to
# the local `mlflow` service; use this to select a promoted alias or version.
MLFLOW_MODEL_URI=models:/triage-urgency-classifier@champion
